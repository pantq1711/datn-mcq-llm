# Copy thành deploy/.env trên máy chủ rồi điền giá trị thật; chmod 600; KHÔNG commit (.env đã nằm trong .gitignore).
# Compose đọc file này để thay ${...} trong compose.prod.yaml và nạp làm biến môi trường cho app.
# Dùng giá trị chữ-số (ví dụ `openssl rand -hex 24`) cho mật khẩu: tránh ký tự $ (Compose sẽ nội suy).

# Để chạy `docker compose ...` trong deploy/ không cần -f. Muốn build image tại chỗ: compose.prod.yaml:compose.build.yaml
COMPOSE_FILE=compose.prod.yaml

# --- Địa chỉ site và image ---
# Tên miền (đã trỏ DNS về máy chủ, mở cổng 80/443). Chạy thử local: localhost (KHÔNG ghi cổng vào đây; đổi cổng
# phía host bằng HTTP_PORT/HTTPS_PORT ở dưới)
SITE_ADDRESS=datn.example.com
# Image trên GHCR (chữ thường). APP_TAG: latest, sha-<7 ký tự>, hoặc phiên bản v* đã đẩy lên
IMAGE_PREFIX=ghcr.io/pantq1711/datn-mcq-llm
APP_TAG=latest
# Chạy thử local qua http/cert tự ký thì đặt HSTS=max-age=0 và (chỉ khi dùng http) COOKIE_SECURE=false
HSTS=max-age=31536000
COOKIE_SECURE=true

# --- PostgreSQL (container db, không mở cổng ra ngoài) ---
DB_NAME=datn_mcq
DB_USER=datn
DB_PASSWORD=

# --- Đăng nhập ---
# Bắt buộc: base64, từ 32 byte. Tạo bằng: openssl rand -base64 48
JWT_SECRET=
# Origin của site (cùng domain với SITE_ADDRESS), có https://. Nhiều giá trị phân tách bằng dấu phẩy
CORS_ALLOWED_ORIGINS=https://datn.example.com
# Admin đầu tiên: chỉ tạo khi chưa có admin, không ghi đè. Mật khẩu từ 12 ký tự (tối đa 72 byte).
# Tạo xong (log có dòng "Đã tạo tài khoản admin đầu tiên") thì XÓA ADMIN_PASSWORD rồi `docker compose up -d`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên

# --- Gemini ---
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_SOLVER_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=
# Chỉ đặt khi kiểm chứng bằng Gemini giả; để trống thì gọi Gemini thật
LLM_BASE_URL=

# --- Tùy chọn (mặc định trong ngoặc) ---
# JWT_ACCESS_TTL (15m), REFRESH_TTL (7d), REFRESH_ABSOLUTE_TTL (30d)
# LOGIN_MAX_FAILURES (5), LOGIN_FAILURE_WINDOW (15m), LOGIN_LOCK_DURATION (15m)
# WORKER_POLL_DELAY_MS (15000), WORKER_MAX_ATTEMPTS (3), WORKER_STALE_AFTER_SECONDS (300)
# JAVA_TOOL_OPTIONS: đặt lại sẽ thay toàn bộ cờ JVM trong image (heap 55% bộ nhớ container, múi giờ, headless)
# MATERIAL_PANDOC_HEAP_MB (256): trần heap RTS cho Pandoc khi xuất Word/trích docx (+RTS -M<N>m -RTS)
# MATERIAL_MAX_CONCURRENT (1): số lượt trích tài liệu và xuất Word đồng thời tối đa (chung 1 permit trên VPS 2GB)
# MATERIAL_QUEUE_WAIT (30s): thời gian xếp hàng tối đa chờ tài nguyên Pandoc/trích xuất trước khi trả lời 503
# HTTP_PORT (80), HTTPS_PORT (443): chỉ đổi khi chạy thử local
