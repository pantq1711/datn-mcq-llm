# Kết nối PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datn_mcq
DB_USER=datn
DB_PASSWORD=

# LLM dùng để sinh câu hỏi và chấm độ khó
LLM_API_KEY=
LLM_MODEL=

# Mô hình embedding dùng cho bước kiểm tra trùng lặp
EMBEDDING_MODEL=

# Đăng nhập JWT (W1-1). JWT_SECRET bắt buộc: base64, từ 32 byte, tạo bằng `openssl rand -base64 48`.
JWT_SECRET=
# Tùy chọn (mặc định): JWT_ACCESS_TTL=15m, REFRESH_TTL=7d, REFRESH_ABSOLUTE_TTL=30d, COOKIE_SECURE=true
# Origin frontend được gọi API (phân tách bằng dấu phẩy); mặc định Vite dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Admin đầu tiên: chỉ tạo khi chưa có admin, không ghi đè. Mật khẩu từ 12 ký tự; tạo xong nên xóa ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Giới hạn đăng nhập sai (mặc định): LOGIN_MAX_FAILURES=5, LOGIN_FAILURE_WINDOW=15m, LOGIN_LOCK_DURATION=15m
# Sau nginx đặt native để lấy IP thật từ X-Forwarded-For (mặc định none).
FORWARD_HEADERS_STRATEGY=none
