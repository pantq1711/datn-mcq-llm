# Kết nối PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datn_mcq
DB_USER=datn
DB_PASSWORD=

# LLM dùng để sinh câu hỏi và chấm độ khó
LLM_API_KEY=
LLM_MODEL=
# Tùy chọn: model cho Solver (mặc định gemini-3.5-flash-lite)
# LLM_SOLVER_MODEL=
# Tùy chọn (W1-5): địa chỉ gốc Gemini, chỉ đặt khi kiểm chứng bằng Gemini giả; để trống = Gemini thật
# LLM_BASE_URL=

# Mô hình embedding dùng cho bước kiểm tra trùng lặp
EMBEDDING_MODEL=

# Đăng nhập JWT (W1-1). JWT_SECRET bắt buộc: base64, từ 32 byte, tạo bằng `openssl rand -base64 48`.
JWT_SECRET=
# Tùy chọn (mặc định): JWT_ACCESS_TTL=15m, REFRESH_TTL=7d, REFRESH_ABSOLUTE_TTL=30d, COOKIE_SECURE=true
# Origin frontend được gọi API (phân tách bằng dấu phẩy); mặc định Vite dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Admin đầu tiên: chỉ tạo khi chưa có admin, không ghi đè. Mật khẩu từ 12 ký tự; tạo xong nên xóa ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Giới hạn đăng nhập sai (mặc định): LOGIN_MAX_FAILURES=5, LOGIN_FAILURE_WINDOW=15m, LOGIN_LOCK_DURATION=15m
# Chạy trực tiếp (dev): none. Sau proxy (Caddy/nginx) PHẢI đặt native để lấy IP thật từ X-Forwarded-For, nếu không mọi
# người dùng chung một IP và giới hạn đăng nhập sai khóa được tài khoản của người khác. compose.prod.yaml đã đặt sẵn.
FORWARD_HEADERS_STRATEGY=none

# Worker sinh câu chạy cùng app. Mặc định false (dev/test); môi trường thật PHẢI là true, không thì job nằm pending mãi.
# compose.prod.yaml đã đặt sẵn true.
WORKER_ENABLED=false
# Cookie refresh có cờ Secure (mặc định true). Chỉ đặt false khi chạy qua http không phải localhost.
# COOKIE_SECURE=true
# Đường dẫn pandoc nếu không nằm trên PATH (xuất Word)
# PANDOC_PATH=pandoc

# Triển khai máy chủ dùng deploy/.env (xem deploy/.env.example và docs/deploy/README.md), không dùng file này.
